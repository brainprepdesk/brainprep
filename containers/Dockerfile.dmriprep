# check=skip=InvalidDefaultArgInFrom

# ---------- Global Build Arguments ----------
ARG BASE_IMAGE
ARG AMICO_VERSION

# ---------- Final Stage ----------
FROM ${BASE_IMAGE} AS final
ARG AMICO_VERSION

# Install system dependencies (minimal)
RUN apt-get -qq update \
    && apt-get install -yq --no-install-recommends \
        bc \
        dc \
        git \
        libfftw3-single3 \
        libfftw3-double3 \
        nano \
        nodejs \
        npm \
        tcsh \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy artifacts from builder stages
COPY --from=synthstrip-installer /opt/freesurfer /opt/freesurfer
COPY --from=synthstrip-installer /opt/py310 /opt/py310
COPY --from=synthstrip-installer /usr/local/bin/mri_synthstrip /usr/local/bin/mri_synthstrip
COPY --from=ants-installer /opt/ants /opt/ants
COPY --from=fsl-installer /opt/fsl /opt/fsl
COPY --from=mrtrix3-installer /opt/mrtrix3 /opt/mrtrix3
COPY --from=mrtrix3-installer /opt/robex /opt/robex
COPY --from=mrtrix3-installer /opt/freesurfer /opt/freesurfer
COPY --from=geolab-installer /opt/geolab /opt/geolab
COPY --from=geolab-installer /usr/local/bin/ProjectAtlasGeoLab /usr/local/bin/ProjectAtlasGeoLab
COPY --from=geolab-installer /usr/local/bin/ConvertBundleFormat /usr/local/bin/ConvertBundleFormat
COPY --from=tractseg-installer /opt/tractseg /opt/tractseg
COPY --from=tractseg-installer /usr/local/bin/TractSeg /usr/local/bin/TractSeg
COPY --from=tractseg-installer /usr/local/bin/Tracking /usr/local/bin/Tracking
COPY --from=tractseg-installer /usr/local/bin/Tractometry /usr/local/bin/Tractometry
COPY --from=synb0-installer /opt/synb0 /opt/synb0
COPY --from=synb0-installer /opt/convert3d /opt/convert3d
COPY --from=synb0-installer /usr/local/bin/synb0 /usr/local/bin/synb0
COPY --from=mni512-downloader /opt/512inMNI.nii /opt/512inMNI.nii
COPY --from=adhd200-downloader /opt/ADHD200_parcellate_200.nii.gz /opt/ADHD200_parcellate_200.nii.gz

# AMICO
WORKDIR /opt/brainprep
RUN pixi add --pypi dmri-amico==${AMICO_VERSION}

# Entrypoint
COPY entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh
ENTRYPOINT ["/opt/entrypoint.sh"]

# Environment variables
ENV MNI_PERL5LIB=/opt/freesurfer/mni/lib/perl5/5.8.5 \
    PERL5LIB=/opt/freesurfer/mni/lib/perl5/5.8.5 \
    FSLOUTPUTTYPE=NIFTI \
    PYTHONPATH=/opt/mrtrix3/lib
ENV DEFAULT_ARGS="subject-level-dmriprep group-level-dmriprep"
