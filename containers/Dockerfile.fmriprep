# ---------- Global Build Arguments ----------
ARG DATE="2026-09-29"
ARG BRAINPREP_VERSION=2.2.0
ARG FMRIPREP_VERSION=25.2.4

# ---------- From Existing Image ----------
FROM nipreps/fmriprep:${FMRIPREP_VERSION}

# Environment
ENV PATH=${HOME}/.pixi/bin:${PATH} \
    DEFAULT_ARGS="subject-level-fmriprep"

# Pixi
RUN curl -fsSL https://pixi.sh/install.sh | bash \
    && pixi --version

# Brainprep
WORKDIR /opt/brainprep
RUN pixi init -c conda-forge \
    && pixi add python=3.12 \
    && pixi add --pypi --git https://github.com/brainprepdesk/brainprep.git --branch main brainprep \
    && pixi clean cache -y \
    && ln -s /opt/brainprep/.pixi/envs/default/bin/brainprep /usr/local/bin/brainprep

# Entrypoint
COPY entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh
ENTRYPOINT ["/opt/entrypoint.sh"]
