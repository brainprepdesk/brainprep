# check=skip=InvalidDefaultArgInFrom

# ---------- Global Build Arguments ----------
ARG BASE_IMAGE

# ---------- Final Stage ----------
FROM ${BASE_IMAGE} AS final

# Copy artifacts from builder stages
COPY --from=morphologist-installer /opt/morphologist /opt/morphologist
COPY --from=morphologist-installer /usr/local/bin/morphologist-wrapper /usr/local/bin/morphologist-wrapper

# Entrypoint
COPY entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh
ENTRYPOINT ["/opt/entrypoint.sh"]

# Environment variables
ENV DEFAULT_ARGS="subject-level-sulcirec"
