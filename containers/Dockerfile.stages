# ---------- Global Build Arguments ----------
ARG DEBIAN_FRONTEND="noninteractive"
ARG OS_VERSION="24.04"
ARG DATE
ARG BRAINPREP_VERSION
ARG ANTS_VERSION
ARG SYNTHSTRIP_VERSION="1.8"
ARG FSLUTILS_VERSION
ARG FSLFLIRT_VERSION
ARG FSLDEFACE_VERSION
ARG FSLEDDY_VERSION
ARG FSLDATASTANDARD_VERSION
ARG MORPHOLOGIST_VERSION
ARG CAT12_VERSION
ARG CAT12MCR_VERSION
ARG FREESURFER_VERSION
ARG MRTRIX3_VERSION
ARG GEOLAB_VERSION
ARG TRACTSEG_VERSION
ARG SYNB0_VERSION

# ---------- Base Stage: Core Dependencies ----------
FROM ubuntu:${OS_VERSION} AS base
ARG DATE
ARG BRAINPREP_VERSION
ARG ANTS_VERSION
ARG SYNTHSTRIP_VERSION
ARG FSLUTILS_VERSION
ARG FSLFLIRT_VERSION
ARG FSLDEFACE_VERSION
ARG MORPHOLOGIST_VERSION

# System
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        curl \
        wget \
        unzip \
        python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Pixi
ENV PATH="/root/.pixi/bin:${PATH}"
RUN curl -fsSL https://pixi.sh/install.sh | bash \
    && pixi --version

# Brainprep
WORKDIR /opt/brainprep
RUN pixi init -c conda-forge \
    && pixi add python=3.12 \
    && pixi add --pypi --git https://github.com/brainprepdesk/brainprep.git --branch main brainprep \
    && pixi clean cache -y \
    && ln -s /opt/brainprep/.pixi/envs/default/bin/brainprep /usr/local/bin/brainprep

# Environment variables
ENV ESBA_DIR=/opt/geolab/atlas/short \
    ANTSPATH=/opt/ants \
    FREESURFER_HOME=/opt/freesurfer \
    FSLDIR=/opt/fsl/.pixi/envs/default \
    FSLOUTPUTTYPE=NIFTI_GZ \
    FSLMULTIFILEQUIT=TRUE \
    FSLTCLSH=/opt/fsl/.pixi/envs/default/bin/fsltclsh \
    FSLWISH=/opt/fsl/.pixi/envs/default/bin/fslwish \
    MATLABCMD=/opt/spm12_mcr/toolbox/matlab \
    FORCE_SPMMCR=1 \
    SPM_HTML_BROWSER=0 \
    MCR_INHIBIT_CTF_LOCK=1 \
    SPMROOT=/opt/cat12 \
    FREESURFER_HOME=/opt/freesurfer \
    SUBJECTS_DIR=/opt/freesurfer/subjects \
    FIX_VERTEX_AREA= \
    FMRI_ANALYSIS_DIR=/opt/freesurfer/fsfast \
    FREESURFER_HOME_FSPYTHON=/usr/local/freesurfer/${FREESURFER_VERSION} \
    FREESURFER=/usr/local/freesurfer/${FREESURFER_VERSION} \
    FSFAST_HOME=/opt/freesurfer/fsfast \
    FSF_OUTPUT_FORMAT=nii.gz \
    FS_OVERRIDE=0 \
    FUNCTIONALS_DIR=/opt/freesurfer/sessions \
    LOCAL_DIR=/opt/freesurfer/local \
    MINC_BIN_DIR=/opt/freesurfer/mni/bin \
    MINC_LIB_DIR=/opt/freesurfer/mni/lib \
    MNI_DATAPATH=/opt/freesurfer/mni/data \
    MNI_DIR=/opt/freesurfer/mni \
    MNI_PERL5LIB=/opt/freesurfer/mni/share/perl5 \
    OS=Linux \
    PERL5LIB=/opt/freesurfer/mni/share/perl5 \
    PATH=/root/.pixi/bin:\
/opt/convert3d/c3d-1.0.0-Linux-x86_64/bin:/opt/mrtrix3/bin:/opt/ROBEX:/opt/geolab/code/build/bin:\
/opt/freesurfer/bin:/opt/freesurfer/fsfast/bin:/opt/freesurfer/tktools:/opt/freesurfer/mni/bin:\
/opt/cat12:/opt/fsl/.pixi/envs/default/bin:/opt/ants/bin:\
$PATH


# ---------- ANTs Stage ----------
FROM base AS ants-installer
ARG OS_VERSION
ARG ANTS_VERSION

# ANTs
WORKDIR /opt/ants-tmp
RUN wget --no-check-certificate -q https://github.com/ANTsX/ANTs/releases/download/v${ANTS_VERSION}/ants-${ANTS_VERSION}-ubuntu-${OS_VERSION}-X64-gcc.zip \
    && unzip ants-${ANTS_VERSION}-ubuntu-${OS_VERSION}-X64-gcc.zip \
    && mv /opt/ants-tmp/ants-${ANTS_VERSION} /opt/ants \
    && rm -r /opt/ants-tmp


# ---------- FSL Stage ----------
FROM base AS fsl-installer
ARG FSLUTILS_VERSION
ARG FSLFLIRT_VERSION
ARG FSLDEFACE_VERSION
ARG FSLEDDY_VERSION
ARG FSLDATASTANDARD_VERSION

# FSL
WORKDIR /opt/fsl
RUN pixi init -c conda-forge -c https://fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/public \
    && pixi add fsl-utils=${FSLUTILS_VERSION} \
    && pixi add fsl-flirt=${FSLFLIRT_VERSION} \
    && pixi add fsl-deface=${FSLDEFACE_VERSION} \
    && pixi add fsl-eddy==${FSLEDDY_VERSION} \
    && pixi add fsl-data_standard==${FSLDATASTANDARD_VERSION} \
    && pixi clean cache -y


# ---------- Synthstrip Stage ----------
FROM freesurfer/synthstrip:${SYNTHSTRIP_VERSION} AS synthstrip-base

FROM base AS synthstrip-installer
ARG FSLUTILS_VERSION

# Copy artifacts from builder stages
COPY --from=synthstrip-base /freesurfer /opt/freesurfer

# FSL
WORKDIR /opt/fsl
RUN pixi init -c conda-forge -c https://fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/public \
    && pixi add fsl-utils=${FSLUTILS_VERSION} \
    && pixi clean cache -y

# Python3.10
WORKDIR /opt/py310
RUN pixi init -c conda-forge \
    && pixi add python=3.10 \
    && pixi clean cache -y

# Command
RUN echo '#!/bin/bash' > /usr/local/bin/mri_synthstrip && \
    echo 'PYTHONPATH="/opt/freesurfer/env/lib/python3.10/site-packages" \\' >> /usr/local/bin/mri_synthstrip && \
    echo '    /opt/py310/.pixi/envs/default/bin/python /opt/freesurfer/mri_synthstrip "$@"' >> /usr/local/bin/mri_synthstrip && \
    chmod +x /usr/local/bin/mri_synthstrip


# ---------- Morphologist Stage ----------
FROM base AS morphologist-installer
ARG MORPHOLOGIST_VERSION

# Morphologist
WORKDIR /opt/morphologist
RUN pixi init -c conda-forge -c https://brainvisa.info/neuro-forge \
    && pixi add morphologist=${MORPHOLOGIST_VERSION} \
    && pixi clean cache -y
RUN echo -e "\n\n[activation.env]\nLD_PRELOAD = \"/opt/morphologist/.pixi/envs/default/mesalib/lib/libglapi.so.0:/opt/morphologist/.pixi/envs/default/mesalib/lib/libGL.so.1\"\n" >> ./pixi.toml \
    && echo -e "\n[tasks.morphologist-wrapper]\ncmd = \"bash -c 'echo $LD_PRELOAD; morphologist-cli'\"\n" >> ./pixi.toml \
    && echo -e "\n[tasks.morphologist-wrapper.env]\nLD_PRELOAD = \"/opt/morphologist/.pixi/envs/default/mesalib/lib/libglapi.so.0:/opt/morphologist/.pixi/envs/default/mesalib/lib/libGL.so.1\"\n" >> ./pixi.toml

# Command
RUN echo '#!/usr/bin/env bash' > /usr/local/bin/morphologist-wrapper \
    && echo 'set -e' >> /usr/local/bin/morphologist-wrapper \
    && echo 'pixi run -m /opt/morphologist/pixi.toml --as-is morphologist-cli "$@"' >> /usr/local/bin/morphologist-wrapper \
    && chmod +x /usr/local/bin/morphologist-wrapper


# ---------- CAT12 Stage ----------
FROM base AS cat12-installer
ARG CAT12_VERSION
ARG CAT12MCR_VERSION

# System
RUN apt-get update -qq \
    && apt-get install -y -q --no-install-recommends \
        libxext6 \
        libxmu6 \
        libxpm-dev \
        libxt6 \
    && rm -rf /var/lib/apt/lists/*

# CAT12
WORKDIR /opt/cat12
RUN mkdir ./tmp \
    && wget --no-check-certificate -q https://github.com/ChristianGaser/cat12/releases/download/${CAT12_VERSION}/CAT${CAT12_VERSION}_${CAT12MCR_VERSION}_MCR_Linux.zip -O ./tmp/cat12_mcr.zip \ 
    && unzip -q ./tmp/cat12_mcr.zip -d ./tmp \
    && mv ./tmp/CAT${CAT12_VERSION}_${CAT12MCR_VERSION}_MCR_Linux/* . \
    && rm -rf ./tmp


# ---------- FreeSurfer Stage ----------
FROM base AS freesurfer-installer
ARG FREESURFER_VERSION

# FreeSurfer
RUN --mount=type=bind,source=./context/freesurfer,target=/context \
    if [ -f /context/freesurfer_ubuntu24-${FREESURFER_VERSION}_amd64.deb ]; then \
        echo "Found local file. Copying..."; \
        cp /context/freesurfer_ubuntu24-${FREESURFER_VERSION}_amd64.deb /tmp/fs.deb; \
    else \
        echo "Local file not found. Fetching via wget..."; \
        wget --progress=dot:giga https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/${FREESURFER_VERSION}/freesurfer_ubuntu24-${FREESURFER_VERSION}_amd64.deb -O /tmp/fs.deb; \
    fi \
    && apt-get update -qq \
    && apt-get install -y /tmp/fs.deb \
    && rm /tmp/fs.deb \
    && ln -s /usr/local/freesurfer/${FREESURFER_VERSION} /opt/freesurfer \
    && dpkg-deb -f /context/freesurfer_ubuntu24-8.2.0_amd64.deb Depends | sed -E 's/\([^)]+\)//g; s/,//g' > /opt/freesurfer/dependencies.txt
RUN wget -q https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/${FREESURFER_VERSION}/fs820_updates.sh -O /tmp/freesurfer_updates.sh \
    && yes y | tr -d '\n' | FREESURFER_HOME=/usr/local/freesurfer/${FREESURFER_VERSION} bash /tmp/freesurfer_updates.sh \
    && rm /tmp/freesurfer_updates.sh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*    

# NextBrain
RUN --mount=type=bind,source=./context/nextbrain,target=/context \
    if [ -f /context/ERC_bayesian_segmentation_810.tgz ]; then \
        echo "Found local file. Copying..."; \
        cp /context/ERC_bayesian_segmentation_810.tgz /opt/freesurfer/python/packages; \
    else \
        echo "Local file not found. Fetching via wget..."; \
        curl -o /opt/freesurfer/python/packages/ERC_bayesian_segmentation_810.tgz \
            https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/stage/ERC_bayesian_segmentation_810.tgz; \
    fi \
    && tar zxpf /opt/freesurfer/python/packages/ERC_bayesian_segmentation_810.tgz -C /opt/freesurfer/python/packages \
    && rm /opt/freesurfer/python/packages/ERC_bayesian_segmentation_810.tgz \
    && if [ -f /context/atlas_simplified.zip ]; then \
        echo "Found local file. Copying..."; \
        cp /context/atlas_simplified.zip /opt/freesurfer/python/packages/ERC_bayesian_segmentation; \
    else \
        echo "Local file not found. Fetching via wget..."; \
        curl -o /opt/freesurfer/python/packages/ERC_bayesian_segmentation/atlas_simplified.zip \
            https://ftp.nmr.mgh.harvard.edu/pub/dist/lcnpublic/dist/Histo_Atlas_Iglesias_2023/atlas_simplified.zip; \
    fi \
    && unzip /opt/freesurfer/python/packages/ERC_bayesian_segmentation/atlas_simplified.zip -d /opt/freesurfer/python/packages/ERC_bayesian_segmentation \
    && rm /opt/freesurfer/python/packages/ERC_bayesian_segmentation/atlas_simplified.zip

# Create a fake cp that filter proviledge argument
RUN echo '#!/bin/bash' > /usr/local/bin/cp \
    && echo 'args=()' >> /usr/local/bin/cp \
    && echo 'for arg in "$@"; do' >> /usr/local/bin/cp \
    && echo '    case "$arg" in' >> /usr/local/bin/cp \
    && echo '        -p|--preserve|--preserve=*) ;;' >> /usr/local/bin/cp \
    && echo '        *) args+=("$arg") ;;' >> /usr/local/bin/cp \
    && echo '    esac' >> /usr/local/bin/cp \
    && echo 'done' >> /usr/local/bin/cp \
    && echo 'echo "[cp wrapper] filtered args: ${args[@]}"' >> /usr/local/bin/cp \
    && echo '/bin/cp "${args[@]}"' >> /usr/local/bin/cp \
    && chmod +x /usr/local/bin/cp


# ---------- MRtrix3 Installer: MRtrix3 #3029 as at 2025-10-21 ----------
FROM base AS mrtrix3-installer
ARG MRTRIX3_VERSION

# Check
RUN if [ "${MRTRIX3_VERSION}" != "26965d" ]; then \
        echo "Error: Build aborted. MRTRIX3_VERSION is set to '${MRTRIX3_VERSION}' but must be '26965d'." \
        && exit 1; \
    fi

# System
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libfftw3-dev \
        ninja-build \
        pkg-config \
        zlib1g-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Robex
WORKDIR /opt/robex
RUN wget --no-check-certificate -qO- "https://www.nitrc.org/frs/download.php/5994/ROBEXv12.linux64.tar.gz//?i_agree=1&download_now=1" | \
    tar zx

# FreeSurfer
WORKDIR /opt
RUN --mount=type=bind,source=./context/mrtrix3,target=/context \
    if [ -f /context/freesurfer-linux-centos8_x86_64-7.4.1.tar.gz ]; then \
        echo "Found local file. Copying..."; \
        cp /context/freesurfer-linux-centos8_x86_64-7.4.1.tar.gz .; \
    else \
        echo "Local file not found. Fetching via wget..."; \
        wget --no-check-certificate https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/7.4.1/freesurfer-linux-centos8_x86_64-7.4.1.tar.gz; \
    fi \
    && tar zxf ./freesurfer-linux-centos8_x86_64-7.4.1.tar.gz -C . \
       --exclude='freesurfer/trctrain' \
       --exclude='freesurfer/subjects/fsaverage_sym' \
       --exclude='freesurfer/subjects/fsaverage3' \
       --exclude='freesurfer/subjects/fsaverage4' \
       --exclude='freesurfer/subjects/fsaverage6' \
       --exclude='freesurfer/subjects/cvs_avg35' \
       --exclude='freesurfer/subjects/cvs_avg35_inMNI152' \
       --exclude='freesurfer/subjects/bert' \
       --exclude='freesurfer/subjects/V1_average' \
       --exclude='freesurfer/average/mult-comp-cor' \
       --exclude='freesurfer/lib/cuda' \
       --exclude='freesurfer/lib/qt' \
    && rm ./freesurfer-linux-centos8_x86_64-7.4.1.tar.gz
RUN wget --no-check-certificate -q "https://s3-eu-west-1.amazonaws.com/pfigshare-u-files/5528816/lh.HCPMMP1.annot" \
        -O /opt/freesurfer/subjects/fsaverage/label/lh.HCPMMP1.annot \
    && wget --no-check-certificate -q "https://s3-eu-west-1.amazonaws.com/pfigshare-u-files/5528819/rh.HCPMMP1.annot" \
        -O /opt/freesurfer/subjects/fsaverage/label/rh.HCPMMP1.annot

# MRtrix3
WORKDIR /opt/mrtrix3
RUN --mount=type=bind,source=./context/mrtrix3,target=/context \
    mkdir ./tmp \
    && cd ./tmp \
    && git clone https://github.com/MRtrix3/mrtrix3.git . \
    && git checkout 26965d57b374a733ac0c583d3b92bad17923128a \
    && git clone https://github.com/Lestropie/dwidenoise2.git dwidenoise2 \
    && cd dwidenoise2 \
    && git checkout a2da5b32876256499a383a52494ca6564009ca85 \
    && cd .. \
    && cp -r dwidenoise2/cpp . \
    && mkdir -p ./python/mrtrix3/commands \
    && cp -r /context/mrtrix3_connectome ./python/mrtrix3/commands \
    && cmake -Bbuild -GNinja --preset=release -DMRTRIX_BUILD_GUI=OFF -DCMAKE_INSTALL_PREFIX=/opt/mrtrix3 \
    && cmake --build build \
    && cmake --install build \
    && cd .. \
    && rm -r ./tmp

ENV MNI_PERL5LIB=/opt/freesurfer/mni/lib/perl5/5.8.5 \
    PERL5LIB=/opt/freesurfer/mni/lib/perl5/5.8.5 \
    FSLOUTPUTTYPE=NIFTI \
    PYTHONPATH=/opt/mrtrix3/lib


# ---------- Geolab Installer ----------
FROM base AS geolab-installer
ARG GEOLAB_VERSION

# Check
RUN if [ "${GEOLAB_VERSION}" != "f5de43" ]; then \
        echo "Error: Build aborted. GEOLAB_VERSION is set to '${GEOLAB_VERSION}' but must be 'f5de43'." \
        && exit 1; \
    fi

# System
RUN apt-get update -qq \
    && apt-get install -y \
        build-essential \
        git \
        libboost-all-dev \
        libeigen3-dev \
        libncurses5-dev \
        libncursesw5-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Geolab
WORKDIR /opt/geolab
RUN pixi init \
    && pixi add \
        python==3.12 \
        numpy \
    && pixi add --pypi  \
        "setproctitle>=1.2."3 \
        "fitter>=1.5.1" \
        "nibabel>=3.2.2" \
    && pixi add \
        ncurses \
        boost \
        eigen \
        openmp \
    && pixi add \
        gcc_linux-64 \
        gxx_linux-64 \
        cmake==3.20.2 \
        make pkg-config \
    && pixi clean cache -y
RUN --mount=type=bind,source=./context/geolab,target=/context \
    git clone --depth 1 https://github.com/vindasna/GeoLab ./code \
    && cd code \
    && git fetch --depth 1 origin f5de43c05b3eeb20823f647d271f6e845c4f6d4b \
    && git checkout f5de43c05b3eeb20823f647d271f6e845c4f6d4b \
    && mkdir /opt/geolab/atlas \
    && cp -r /context/atlas/short /opt/geolab/atlas
RUN rm -r code/build \
    && mkdir code/build \
    && cd code/build \
    && pixi run cmake .. \
    && pixi run make -j"$(nproc)"
RUN echo '\n[activation.env]' >> pixi.toml \
    && echo 'PATH="/opt/geolab/code/build/bin:${PATH}"' >> pixi.toml \
    && echo 'PYTHONPATH="/opt/geolab/code:${PYTHONPATH}"' >> pixi.toml \
    && echo 'ESBA_DIR="/opt/geolab/atlas/short"' >> pixi.toml

# Commands
RUN echo '#!/bin/bash' > /usr/local/bin/ProjectAtlasGeoLab && \
    echo 'pixi run -m /opt/geolab/pixi.toml ProjectAtlasGeoLab "$@"' >> /usr/local/bin/ProjectAtlasGeoLab && \
    chmod +x /usr/local/bin/ProjectAtlasGeoLab
RUN echo '#!/bin/bash' > /usr/local/bin/ConvertBundleFormat && \
    echo 'pixi run -m /opt/geolab/pixi.toml ConvertBundleFormat "$@"' >> /usr/local/bin/ConvertBundleFormat && \
    chmod +x /usr/local/bin/ConvertBundleFormat


# ---------- TractSeg Installer ----------
FROM base AS tractseg-installer
ARG TRACTSEG_VERSION

# TractSeg
WORKDIR /opt/tractseg
RUN pixi init \
    && pixi add \
        python==3.12 \
        dipy==1.12.1 \
        libgl \
        xorg-libxrender \
    && pixi add --pypi \
        torch==2.11.0 \
        TractSeg==${TRACTSEG_VERSION}

# Commands
RUN echo '#!/bin/bash' > /usr/local/bin/TractSeg && \
    echo 'pixi run  --as-is -m /opt/tractseg/pixi.toml TractSeg "$@"' >> /usr/local/bin/TractSeg && \
    chmod +x /usr/local/bin/TractSeg
RUN echo '#!/bin/bash' > /usr/local/bin/Tracking && \
    echo 'pixi run --as-is -m /opt/tractseg/pixi.toml Tracking "$@"' >> /usr/local/bin/Tracking && \
    chmod +x /usr/local/bin/Tracking
RUN echo '#!/bin/bash' > /usr/local/bin/Tractometry && \
    echo 'pixi run --as-is -m /opt/tractseg/pixi.toml Tractometry "$@"' >> /usr/local/bin/Tractometry && \
    chmod +x /usr/local/bin/Tractometry


# ---------- Synb0 Installer ----------
FROM base AS synb0-installer
ARG SYNB0_VERSION

# Check
RUN if [ "${SYNB0_VERSION}" != "v3" ]; then \
        echo "Error: Build aborted. SYNB0_VERSION is set to '${SYNB0_VERSION}' but must be 'v3'." \
        && exit 1; \
    fi

# Convert3d
WORKDIR /opt/convert3d
RUN wget --no-check-certificate -O c3d-1.0.0-Linux-x86_64.tar.gz "https://downloads.sourceforge.net/project/c3d/c3d/1.0.0/c3d-1.0.0-Linux-x86_64.tar.gz?r=https%3A%2F%2Fsourceforge.net%2Fprojects%2Fc3d%2Ffiles%2Fc3d%2F1.0.0%2Fc3d-1.0.0-Linux-x86_64.tar.gz%2Fdownload&ts=1571934949" \
   && tar -xf c3d-1.0.0-Linux-x86_64.tar.gz \
   && rm c3d-1.0.0-Linux-x86_64.tar.gz

# Synb0
WORKDIR /opt/synb0
RUN  --mount=type=bind,source=./context/synb0,target=/context \
    pixi init \
    && pixi add \
        python==3.6.15 \
    && pixi add --pypi \
        nibabel==2.4.0 \
        numpy==1.16.3 \
        Pillow==6.0.0 \
        scipy==1.3.0 \
        six==1.12.0 \
        torch==1.1.0 \
        torchvision==0.2.2.post3 \
    && cp -r /context/synb0/* .

# Command
RUN echo '#!/bin/bash' > /usr/local/bin/synb0 && \
    echo 'pixi run  --as-is -m /opt/synb0/pixi.toml /opt/synb0/synb0.sh "$@"' >> /usr/local/bin/synb0 && \
    chmod +x /usr/local/bin/synb0


# ---------- Downloader Stages ----------
FROM base AS aal-downloader
WORKDIR /opt/aal
RUN wget --no-check-certificate \
        https://data.kg.ebrains.eu/zip?container=https://data-proxy.ebrains.eu/api/v1/buckets/p4791e-ext-d000035_AAL1Atlas_pub?prefix=Release2018_SPM12 \
       -O aal1_for_SPM12.zip \
   && unzip aal1_for_SPM12.zip \
   && rm -f aal1_for_SPM12.zip \
   && unzip aal_for_SPM12.zip \
   && rm -f aal_for_SPM12.zip \
   && mv aal_for_SPM12/* . \
   && rmdir aal_for_SPM12 \
   && rm -rf __MACOSX \
   && wget --no-check-certificate -qO- http://www.gin.cnrs.fr/wp-content/uploads/aal2_for_SPM12.tar.gz | \
      tar zx --strip-components=1

FROM base AS adhd200-downloader
WORKDIR /opt
RUN wget --no-check-certificate -qO- http://www.nitrc.org/frs/download.php/5906/ADHD200_parcellations.tar.gz | \
    tar zx \
    && rm -f ADHD200_parcellations.tar.gz

FROM base AS brainnetome-downloader
WORKDIR /opt/brainnetome
RUN \
   ( curl https://pan.cstcloud.cn/unode/stor/downloadByUrl?downloadId=1.eyJidWNrZXQiOiJkZWZhdWx0IiwibGVuIjozODIzMDY1Nywic2l6ZSI6MzgyMzA2NTcsInBvcyI6MCwibmFtZSI6InJoLkJOX0F0bGFzLmdjcyIsImN0aW1lIjoxNzYxNjE3OTkyLCJrZXkiOiJzTEhJaHcxYkZYZ0RTeGRld3I0ZWtxRjJuQ0VBQUFBQ1IxcUIiLCJhZ2UiOjg2NDAwfQ.3670708009 \
            -o rh.BN_Atlas.gcs || \
       wget --no-check-certificate -q "https://osf.io/e6zkg/download" -O rh.BN_Atlas.gcs ) \
