# check=skip=InvalidDefaultArgInFrom

# ---------- Global Build Arguments ----------
ARG BASE_IMAGE

# ---------- Final Stage ----------
FROM ${BASE_IMAGE} AS final

# Copy artifacts from builder stages
COPY --from=freesurfer-installer /opt/freesurfer /opt/freesurfer
COPY --from=freesurfer-installer /usr/local/bin/cp /usr/local/bin/cp

# System
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
         $(cat /opt/freesurfer/dependencies.txt) \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Entrypoint
COPY entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh
ENTRYPOINT ["/opt/entrypoint.sh"]

# Environment variables
ENV DEFAULT_ARGS="subject-level-sbm group-level-sbm longitudinal-sbm"
